{
  // This file should come last, to override all the rest.
  // Update everything at once, every weeks
  "schedule": ["every monday"],

  "packageRules": [
    {
      // Group most of the updates all together, one a week
      "matchUpdateTypes": [
        "minor",
        "patch",
      ],
      "groupName": "non-major",
      "automerge": true,
    },
  ],
}
